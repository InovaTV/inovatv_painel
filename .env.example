NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_ACCESS_TOKEN=

# Storage — armazenamento de arquivos públicos (ver STORAGE.md, ADR-011/ADR-012)
# A aplicação depende só de um "Storage Provider" genérico, não da Hostinger
# especificamente — hoje o único provider implementado é "hostinger".
STORAGE_PROVIDER=hostinger
STORAGE_HOST=
STORAGE_USER=
STORAGE_PASSWORD=
STORAGE_ROOT_PATH=
STORAGE_PUBLIC_BASE_URL=
# Opcionais — só definir se precisar sobrescrever os padrões/detecção automática
STORAGE_SFTP_PORT=
STORAGE_FTP_PORT=
STORAGE_PROTOCOL=
